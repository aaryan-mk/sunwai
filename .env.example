# SunwAI configuration template. Copy to .env and edit.
#
# - No value in this file is a real credential. Fill in your own.
# - Canonical names are SUNWAI_<GROUP>__<FIELD>. Each also accepts the original flat
#   name shown in brackets (for example BODHAN_MODE). Run `sunwai config map` for the full table.
# - Unset means "use the built-in default". Lines starting with '#' are optional overrides;
#   uncomment only what you need. Booleans: true / false.
# - Test-only switches (fault injection, dry-run, dev hooks) are deliberately not listed.

# ---- Essentials -------------------------------------------------------------
# Hosted Bodhan API (BODHAN_MODE=api) or self-hosted replicas (BODHAN_MODE=local).
SUNWAI_BODHAN__MODE=api
SUNWAI_BODHAN__API_KEY=
# LLM backend: openrouter or gemini.
SUNWAI_LLM__PROVIDER=openrouter
SUNWAI_LLM__OPENROUTER_API_KEY=
# Hugging Face token, needed once to download gated pyannote weights.
SUNWAI_PLANNING__HF_TOKEN=
# Directory that holds all job state (media, plans, logs). Keep it out of Git.
SUNWAI_SERVER__DUB_ROOT=./var/jobs
# Enable lip sync dispatch ("proc") or turn it off ("none"). Requires a GPU worker.
# SUNWAI_LIPSYNC__MODE=proc
# Path to your LatentSync checkout (configs and checkpoints).
# SUNWAI_LIPSYNC__LATENTSYNC_DIR=./third_party/LatentSync


# ---- Bodhan ASR / MT / TTS backend -----------------------------------------
# Where ASR/MT/TTS requests go: "api" (hosted, default) or "local" (self-hosted replicas). [BODHAN_MODE]
# SUNWAI_BODHAN__MODE=
# Hosted Bodhan API base URL. [BODHAN_API_BASE]
# SUNWAI_BODHAN__API_BASE=
# Logical MT replica count in api mode (sizes worker pools). [BODHAN_API_MT_FANOUT]
# SUNWAI_BODHAN__API_MT_FANOUT=
# Logical TTS replica count in api mode (sizes worker pools). [BODHAN_API_TTS_FANOUT]
# SUNWAI_BODHAN__API_TTS_FANOUT=
# Hosted ASR requests per minute across all processes (default 60). [BODHAN_API_RPM_ASR]
# SUNWAI_BODHAN__API_RPM_ASR=
# Hosted MT requests per minute (default 100). [BODHAN_API_RPM_MT]
# SUNWAI_BODHAN__API_RPM_MT=
# Hosted TTS requests per minute (default 8). [BODHAN_API_RPM_TTS]
# SUNWAI_BODHAN__API_RPM_TTS=
# Longest a call waits for the hosted rate window, seconds (default 300). [BODHAN_API_RATE_WAIT]
# SUNWAI_BODHAN__API_RATE_WAIT=
# Concurrent hosted calls per service in api mode (default 8). [BODHAN_API_MAX_INFLIGHT]
# SUNWAI_BODHAN__API_MAX_INFLIGHT=
# Local-mode ASR base URL. [ASR_BASE]
# SUNWAI_BODHAN__ASR_BASE=
# Local-mode single MT base URL. [MT_BASE]
# SUNWAI_BODHAN__MT_BASE=
# Local-mode comma-separated MT replica URLs. [MT_BASES]
# SUNWAI_BODHAN__MT_BASES=
# Local-mode comma-separated TTS replica URLs. [TTS_BASE]
# SUNWAI_BODHAN__TTS_BASE=
# IndicTrans2 mirror base URL (always local). [IT2_BASE]
# SUNWAI_BODHAN__IT2_BASE=
# Comma-separated target languages routed to IndicTrans2 instead of Bodhan MT. [IT2_TARGETS]
# SUNWAI_BODHAN__IT2_TARGETS=
# Source-separation service base URL (always local). [SEP_BASE]
# SUNWAI_BODHAN__SEP_BASE=
# Host used for local-mode default URLs and the supervisor probes. [DEP_HOST]
# SUNWAI_BODHAN__DEP_HOST=
# TTS model id sent to the synthesis endpoint. [TTS_MODEL]
# SUNWAI_BODHAN__TTS_MODEL=
# Shared Bodhan API key (per-service BODHAN_<ASR|MT|TTS>_KEY override it). [BODHAN_API_KEY]
# SUNWAI_BODHAN__API_KEY=

# ---- LLM provider (fit-to-slot rewrite, chat planner) ----------------------
# LLM backend: "openrouter" (default) or "gemini". [LLM_PROVIDER]
# SUNWAI_LLM__PROVIDER=
# Default model name (mapped to google/<name> on OpenRouter). [GEMINI_MODEL]
# SUNWAI_LLM__GEMINI_MODEL=
# Model for the control-plane chat planner. [DUB_CHAT_MODEL]
# SUNWAI_LLM__CHAT_MODEL=
# Append-only JSONL path for per-call token and cost records. [LLM_USAGE_LOG]
# SUNWAI_LLM__USAGE_LOG=
# HTTP-Referer header sent to OpenRouter. [OPENROUTER_REFERER]
# SUNWAI_LLM__REFERER=
# X-Title header sent to OpenRouter. [OPENROUTER_TITLE]
# SUNWAI_LLM__TITLE=
# Assumed USD per million input tokens for chat cost accounting. [DUB_CHAT_PRICE_IN]
# SUNWAI_LLM__CHAT_PRICE_IN=
# Assumed USD per million output tokens for chat cost accounting. [DUB_CHAT_PRICE_OUT]
# SUNWAI_LLM__CHAT_PRICE_OUT=
# OpenRouter API key. [OPENROUTER_API_KEY]
# SUNWAI_LLM__OPENROUTER_API_KEY=
# Google Generative Language API key (only when LLM_PROVIDER=gemini). [GEMINI_API_KEY]
# SUNWAI_LLM__GEMINI_API_KEY=

# ---- Planning: download, chunking, diarization -----------------------------
# Target length of the first (latency-critical) chunk, seconds. [FIRST_CHUNK_S]
# SUNWAI_PLANNING__FIRST_CHUNK_S=
# How many chunks a language may run ahead of playback. [CHUNK_LOOKAHEAD]
# SUNWAI_PLANNING__CHUNK_LOOKAHEAD=
# Chunk-length ramp used to shorten early chunks. [CHUNK_RAMP]
# SUNWAI_PLANNING__CHUNK_RAMP=
# Cut each chunk on exact frame ownership boundaries. [CHUNK_EXACT_OWN]
# SUNWAI_PLANNING__CHUNK_EXACT_OWN=
# Maximum seconds a chunk waits for its predecessor gate. [CHUNK_GATE_MAX_WAIT]
# SUNWAI_PLANNING__CHUNK_GATE_MAX_WAIT=
# Absolute chunk start offset passed by the server to chunk processes. [CHUNK_START]
# SUNWAI_PLANNING__CHUNK_START=
# Half-gap in seconds kept around speaker crops. [CROP_HALFGAP]
# SUNWAI_PLANNING__CROP_HALFGAP=
# Enable the gender cache-key fix. [GENDER_KEYFIX]
# SUNWAI_PLANNING__GENDER_KEYFIX=
# Serialise source-language identification across processes. [LID_LOCK]
# SUNWAI_PLANNING__LID_LOCK=
# Seek in the input when downloading a window instead of cutting afterwards. [PLANNER_INPUT_SEEK]
# SUNWAI_PLANNING__PLANNER_INPUT_SEEK=
# Split slots at speaker changes. [SPLIT_SPK]
# SUNWAI_PLANNING__SPLIT_SPK=
# Minimum speaker turn length for a split, seconds. [SPLIT_MIN_SPK_S]
# SUNWAI_PLANNING__SPLIT_MIN_SPK_S=
# Minimum piece length after a split, seconds. [SPLIT_MIN_PIECE_S]
# SUNWAI_PLANNING__SPLIT_MIN_PIECE_S=
# Share the language-independent front half across target languages. [PREP_SHARE]
# SUNWAI_PLANNING__PREP_SHARE=
# Path to a mode-600 cookies file for yt-dlp (optional). [YTDLP_COOKIES]
# SUNWAI_PLANNING__YTDLP_COOKIES=
# Private directory for per-download cookie copies. [YTDLP_COOKIES_TMPDIR]
# SUNWAI_PLANNING__YTDLP_COOKIES_TMPDIR=
# Path to speakers_global.json, set by the server for chunk processes. [SPEAKER_MAP]
# SUNWAI_PLANNING__SPEAKER_MAP=
# Hugging Face token for gated pyannote weights. [HF_TOKEN]
# SUNWAI_PLANNING__HF_TOKEN=

# ---- ASR -------------------------------------------------------------------
# Concurrent ASR calls per chunk process. [ASR_WORKERS]
# SUNWAI_ASR__WORKERS=
# Deduplicate words repeated across slot boundaries. [ASR_DEDUP]
# SUNWAI_ASR__DEDUP=
# Split over-long slots before transcription. [ASR_LONG_SPLIT]
# SUNWAI_ASR__LONG_SPLIT=

# ---- Machine translation ---------------------------------------------------
# Concurrent MT calls per chunk process. [MT_WORKERS]
# SUNWAI_MT__WORKERS=

# ---- Duration fit and meaning guard ----------------------------------------
# Allow the fit stage to trim text to the duration budget. [FIT_TRIM]
# SUNWAI_FIT__TRIM=
# Reject fit rewrites that change numbers, names or negations. [FIT_MEANING_GUARD]
# SUNWAI_FIT__MEANING_GUARD=
# Protect listed terms from rewriting. [FIT_KEEP_LIST]
# SUNWAI_FIT__KEEP_LIST=
# Budget each line with the assigned voice's measured speaking rate. [FIT_VOICE_RATE]
# SUNWAI_FIT__VOICE_RATE=
# Re-fit and re-synthesise lines that overrun after TTS. [REFIT]
# SUNWAI_FIT__REFIT=
# First chunk index allowed to refit (earlier chunks skip it for latency). [REFIT_MIN_CHUNK]
# SUNWAI_FIT__REFIT_MIN_CHUNK=
# Minimum share of target-script letters for an accepted line. [SCRIPT_MIN_SHARE]
# SUNWAI_FIT__SCRIPT_MIN_SHARE=

# ---- TTS: splitting and runaway repair -------------------------------------
# Concurrent TTS calls per chunk process. [TTS_WORKERS]
# SUNWAI_TTS__WORKERS=
# Normalise text for speech before synthesis. [TTS_NORMALIZE]
# SUNWAI_TTS__NORMALIZE=
# Spell numbers out as words for the target language. [TTS_NORMALIZE_NUMBERS]
# SUNWAI_TTS__NORMALIZE_NUMBERS=
# Synthesise long lines sentence by sentence. [TTS_SENT_SPLIT]
# SUNWAI_TTS__SENT_SPLIT=
# Allow word-level splits when no sentence boundary exists. [TTS_SENT_WORDSPLIT]
# SUNWAI_TTS__SENT_WORDSPLIT=
# Time budget for a split synthesis, seconds. [TTS_SENT_DEADLINE_S]
# SUNWAI_TTS__SENT_DEADLINE_S=
# Maximum concurrent pieces per split line. [TTS_SENT_MAX_CONC]
# SUNWAI_TTS__SENT_MAX_CONC=
# Maximum pieces a line may be split into. [TTS_SENT_MAX_PIECES]
# SUNWAI_TTS__SENT_MAX_PIECES=
# Minimum timing drift before a split is attempted. [TTS_SENT_MIN_DRIFT]
# SUNWAI_TTS__SENT_MIN_DRIFT=
# Minimum graphemes for a split piece. [TTS_SENT_MIN_G]
# SUNWAI_TTS__SENT_MIN_G=
# Minimum source pause that justifies a split, seconds. [TTS_SENT_MIN_GAP]
# SUNWAI_TTS__SENT_MIN_GAP=
# Real-time factor above which a split is skipped. [TTS_SENT_SLOW_RTF]
# SUNWAI_TTS__SENT_SLOW_RTF=
# Fraction of slot slack that may be absorbed by stretching pauses. [TTS_SLACK_FRAC]
# SUNWAI_TTS__SLACK_FRAC=
# Maximum pause stretch, seconds. [TTS_SLACK_MAX_PAUSE]
# SUNWAI_TTS__SLACK_MAX_PAUSE=
# Absorb overruns by stretching pauses. [TTS_SLACK_PAUSES]
# SUNWAI_TTS__SLACK_PAUSES=
# Slow slightly-fast lines down toward the slot. [TTS_SLOW]
# SUNWAI_TTS__SLOW=
# Minimum tempo factor when slowing. [TTS_SLOW_MIN]
# SUNWAI_TTS__SLOW_MIN=
# HTTP retries per TTS call. [DUB_TTS_RETRIES]
# SUNWAI_TTS__RETRIES=
# Graphemes-per-second ceiling that flags a runaway synthesis. [PIPE_RUNAWAY_GPS]
# SUNWAI_TTS__RUNAWAY_GPS=
# Enable the runaway repair ladder. [PIPE_RUNAWAY_LADDER]
# SUNWAI_TTS__RUNAWAY_LADDER=
# Time budget per rung of the runaway repair ladder. [PIPE_RUNAWAY_LADDER_S]
# SUNWAI_TTS__RUNAWAY_LADDER_S=
# Absolute duration that always counts as a runaway, seconds. [PIPE_RUNAWAY_MAX_S]
# SUNWAI_TTS__RUNAWAY_MAX_S=
# Maximum repair attempts for a runaway line. [PIPE_RUNAWAY_TRIES]
# SUNWAI_TTS__RUNAWAY_TRIES=

# ---- Mixing: alignment, ducking, limiting ----------------------------------
# Trim leading and trailing silence of synthesised speech. [MIX_TRIM]
# SUNWAI_MIXING__TRIM=
# Relative threshold for silence trimming. [MIX_TRIM_REL]
# SUNWAI_MIXING__TRIM_REL=
# Align dub pauses to the source pauses. [MIX_ALIGN_PAUSES]
# SUNWAI_MIXING__ALIGN_PAUSES=
# Minimum drift before pause alignment acts, seconds. [MIX_ALIGN_MIN_DRIFT]
# SUNWAI_MIXING__ALIGN_MIN_DRIFT=
# Duck the background under speech. [MIX_DUCK]
# SUNWAI_MIXING__DUCK=
# Ducking depth, dB. [MIX_DUCK_DB]
# SUNWAI_MIXING__DUCK_DB=
# Ducking attack time, ms. [MIX_DUCK_ATTACK_MS]
# SUNWAI_MIXING__DUCK_ATTACK_MS=
# Ducking hold time, ms. [MIX_DUCK_HOLD_MS]
# SUNWAI_MIXING__DUCK_HOLD_MS=
# Ducking release time, ms. [MIX_DUCK_RELEASE_MS]
# SUNWAI_MIXING__DUCK_RELEASE_MS=
# Preserve overlapping source speech in the mix. [MIX_KEEP_OVERLAP]
# SUNWAI_MIXING__KEEP_OVERLAP=
# Which overlap kinds are preserved. [MIX_OVERLAP_KINDS]
# SUNWAI_MIXING__OVERLAP_KINDS=
# Maximum seconds cut when removing overlaps. [MIX_OVERLAP_MAX_CUT]
# SUNWAI_MIXING__OVERLAP_MAX_CUT=
# Preserve non-speech events (laughter, applause) from the source. [MIX_KEEP_EVENTS]
# SUNWAI_MIXING__KEEP_EVENTS=
# Classifier threshold for non-speech events. [MIX_EVENT_THR]
# SUNWAI_MIXING__EVENT_THR=
# Minimum event length, seconds. [MIX_EVENT_MIN_S]
# SUNWAI_MIXING__EVENT_MIN_S=
# Maximum candidate events examined per chunk. [MIX_EVENT_MAX_CAND]
# SUNWAI_MIXING__EVENT_MAX_CAND=
# Seconds of source kept before a preserved event. [MIX_KEEP_LEAD]
# SUNWAI_MIXING__KEEP_LEAD=
# Seconds of source kept after a preserved event. [MIX_KEEP_TAIL]
# SUNWAI_MIXING__KEEP_TAIL=
# Match dub loudness to the source. [MIX_LEVEL_FIX]
# SUNWAI_MIXING__LEVEL_FIX=
# Apply the output peak limiter. [MIX_LIMITER]
# SUNWAI_MIXING__LIMITER=
# Limiter look-ahead, ms. [MIX_LIM_LOOKAHEAD_MS]
# SUNWAI_MIXING__LIM_LOOKAHEAD_MS=
# Limiter release, ms. [MIX_LIM_RELEASE_MS]
# SUNWAI_MIXING__LIM_RELEASE_MS=
# Write intermediate stems for debugging. [MIX_DUMP_STEM]
# SUNWAI_MIXING__DUMP_STEM=
# Glob of a local AudioSet-AST snapshot used for event detection. [MIX_AST_DIR]
# SUNWAI_MIXING__AST_DIR=
# Mux the full chunk audio rather than only the speech window. [MUX_FULL_AUDIO]
# SUNWAI_MIXING__MUX_FULL_AUDIO=

# ---- Pipeline limits and retries -------------------------------------------
# Timeout for ffmpeg subprocesses, seconds. [PIPE_FFMPEG_TIMEOUT]
# SUNWAI_PIPELINE__FFMPEG_TIMEOUT=
# Longest audio accepted from a service, seconds. [PIPE_MAX_AUDIO_S]
# SUNWAI_PIPELINE__MAX_AUDIO_S=
# Maximum fraction of speech allowed to use degraded fallbacks. [FALLBACK_MAX_FRAC]
# SUNWAI_PIPELINE__FALLBACK_MAX_FRAC=
# HTTP retries per service call. [DUB_RETRIES]
# SUNWAI_PIPELINE__RETRIES=
# Separate retry budget for HTTP 429 answers (default 5). [DUB_429_RETRIES]
# SUNWAI_PIPELINE__RETRIES_429=
# Overall deadline for retrying one service call, seconds. [DUB_RETRY_DEADLINE]
# SUNWAI_PIPELINE__RETRY_DEADLINE=
# Enable cross-process service concurrency slots. [DUB_SLOTS]
# SUNWAI_PIPELINE__SLOTS=
# Directory holding the cross-process slot lock files. [DUB_SLOT_DIR]
# SUNWAI_PIPELINE__SLOT_DIR=
# Maximum wait for a service slot, seconds. [DUB_SLOT_WAIT]
# SUNWAI_PIPELINE__SLOT_WAIT=
# Timeout for a single-line re-synthesis, seconds. [DUB_RESYNTH_TIMEOUT]
# SUNWAI_PIPELINE__RESYNTH_TIMEOUT=
# Timeout waiting for the edit gate, seconds. [DUB_EDIT_GATE_TIMEOUT]
# SUNWAI_PIPELINE__EDIT_GATE_TIMEOUT=
# Enable expression (delivery) controls. [EXPRESSION_ENABLED]
# SUNWAI_PIPELINE__EXPRESSION_ENABLED=
# Timeout for expression-preview ffmpeg calls, seconds. [EXPR_FFMPEG_TIMEOUT]
# SUNWAI_PIPELINE__EXPR_FFMPEG_TIMEOUT=

# ---- Lip sync --------------------------------------------------------------
# Lip-sync dispatch: "proc" (worker processes) or "none". [LIP_MODE]
# SUNWAI_LIPSYNC__MODE=
# Comma-separated lip-sync worker ids. [LIP_WORKERS]
# SUNWAI_LIPSYNC__WORKERS=
# Enable the active-speaker gate. [LIP_ASD]
# SUNWAI_LIPSYNC__ASD=
# Active-speaker gate batch size. [LIP_ASD_BS]
# SUNWAI_LIPSYNC__ASD_BS=
# SyncNet confidence needed to call a face speaking. [LIP_ASD_CONF]
# SUNWAI_LIPSYNC__ASD_CONF=
# Maximum audio-video offset accepted by the gate, frames. [LIP_ASD_OFFMAX]
# SUNWAI_LIPSYNC__ASD_OFFMAX=
# Motion threshold below which a face counts as static. [LIP_ASD_STATIC]
# SUNWAI_LIPSYNC__ASD_STATIC=
# Also run SyncNet on static faces. [LIP_ASD_STATIC_SYNC]
# SUNWAI_LIPSYNC__ASD_STATIC_SYNC=
# Release the CUDA cache between chunks. [LIP_EMPTY_CACHE]
# SUNWAI_LIPSYNC__EMPTY_CACHE=
# Per-process CUDA memory fraction cap. [LIP_GPU_FRAC]
# SUNWAI_LIPSYNC__GPU_FRAC=
# Handle several faces per shot. [LIP_MULTIFACE]
# SUNWAI_LIPSYNC__MULTIFACE=
# Use the ROI paste-back with colour matching. [LIP_PASTE_V2]
# SUNWAI_LIPSYNC__PASTE_V2=
# Path to the upstream LatentSync checkout (configs and checkpoints). [LATENTSYNC_DIR]
# SUNWAI_LIPSYNC__LATENTSYNC_DIR=

# ---- Control plane: actions, chat, expression, add-language ----------------
# Enable the validated control plane (actions, chat, events). [DUB_ACTIONS]
# SUNWAI_CONTROL__ACTIONS=
# Shared token for the control plane; generated into the state dir when unset. [DUB_CTL_TOKEN]
# SUNWAI_CONTROL__TOKEN=
# Enable the chat planner. [DUB_CHAT]
# SUNWAI_CONTROL__CHAT=
# Allow adding a target language mid-watch. [DUB_ADD_LANG]
# SUNWAI_CONTROL__ADD_LANG=
# Control-plane switch for add-language actions. [DUB_CTL_ADDLANG]
# SUNWAI_CONTROL__ADDLANG=
# Time budget for an add-language action, seconds. [DUB_CTL_ADDLANG_S]
# SUNWAI_CONTROL__ADDLANG_S=
# Lifetime of a confirmation token, seconds. [DUB_CTL_CONFIRM_TTL]
# SUNWAI_CONTROL__CONFIRM_TTL=
# Daily synthesis-seconds cap. [DUB_CTL_DAILY_SYNTH_S]
# SUNWAI_CONTROL__DAILY_SYNTH_S=
# Daily chat spend cap, USD. [DUB_CTL_DAILY_USD]
# SUNWAI_CONTROL__DAILY_USD=
# Events kept per job. [DUB_CTL_EV_KEEP]
# SUNWAI_CONTROL__EV_KEEP=
# Maximum bytes of the event log per job. [DUB_CTL_EV_MAX_BYTES]
# SUNWAI_CONTROL__EV_MAX_BYTES=
# Events replayed to a reconnecting client. [DUB_CTL_EV_REPLAY]
# SUNWAI_CONTROL__EV_REPLAY=
# Global LLM calls per minute. [DUB_CTL_GEMINI_PER_MIN]
# SUNWAI_CONTROL__GEMINI_PER_MIN=
# Global concurrent syntheses. [DUB_CTL_GLOBAL_SYNTH]
# SUNWAI_CONTROL__GLOBAL_SYNTH=
# Per-IP action requests per minute. [DUB_CTL_IP_ACTIONS_PER_MIN]
# SUNWAI_CONTROL__IP_ACTIONS_PER_MIN=
# Per-IP chat requests per minute. [DUB_CTL_IP_CHAT_PER_MIN]
# SUNWAI_CONTROL__IP_CHAT_PER_MIN=
# Per-IP poll requests per minute. [DUB_CTL_IP_POLL_PER_MIN]
# SUNWAI_CONTROL__IP_POLL_PER_MIN=
# Per-IP read requests per minute. [DUB_CTL_IP_READ_PER_MIN]
# SUNWAI_CONTROL__IP_READ_PER_MIN=
# Maximum concurrently added languages. [DUB_CTL_LANG_MAX]
# SUNWAI_CONTROL__LANG_MAX=
# Chunk errors tolerated before an added language is abandoned. [DUB_CTL_LANG_MAX_ERRS]
# SUNWAI_CONTROL__LANG_MAX_ERRS=
# Window over which chunk errors are counted, seconds. [DUB_CTL_LANG_MAX_ERR_S]
# SUNWAI_CONTROL__LANG_MAX_ERR_S=
# Poll interval of the language scheduler, seconds. [DUB_CTL_LANG_POLL]
# SUNWAI_CONTROL__LANG_POLL=
# Maximum wait for a segment lock, seconds. [DUB_CTL_LOCK_WAIT_S]
# SUNWAI_CONTROL__LOCK_WAIT_S=
# Poll interval while waiting for lip sync, seconds. [DUB_CTL_LS_POLL]
# SUNWAI_CONTROL__LS_POLL=
# Maximum wait for lip sync, seconds. [DUB_CTL_LS_WAIT]
# SUNWAI_CONTROL__LS_WAIT=
# Timeout for an expression operation, seconds. [DUB_CTL_M2_TIMEOUT_S]
# SUNWAI_CONTROL__M2_TIMEOUT_S=
# Maximum concurrent control-plane syntheses. [DUB_CTL_MAX_SYNTH]
# SUNWAI_CONTROL__MAX_SYNTH=
# Preview requests per minute. [DUB_CTL_PREVIEWS_PER_MIN]
# SUNWAI_CONTROL__PREVIEWS_PER_MIN=
# Per-job chat spend cap, USD. [DUB_CTL_SPEND_CAP_USD]
# SUNWAI_CONTROL__SPEND_CAP_USD=
# Concurrent event streams per job. [DUB_CTL_SSE_PER_JOB]
# SUNWAI_CONTROL__SSE_PER_JOB=
# Concurrent event streams overall. [DUB_CTL_SSE_TOTAL]
# SUNWAI_CONTROL__SSE_TOTAL=
# Per-action synthesis-seconds cap. [DUB_CTL_SYNTH_CAP_S]
# SUNWAI_CONTROL__SYNTH_CAP_S=

# ---- HTTP server, admission and limits -------------------------------------
# Directory holding all job state. [DUB_ROOT]
# SUNWAI_SERVER__DUB_ROOT=
# Port the server listens on. [PORT]
# SUNWAI_SERVER__PORT=
# Maximum concurrently running chunk processes. [MAX_CONCURRENT]
# SUNWAI_SERVER__MAX_CONCURRENT=
# Optional shared secret required for mutating /api/ calls. [DUB_TOKEN]
# SUNWAI_SERVER__TOKEN=
# Comma-separated allowed CORS origins. [DUB_CORS_ORIGINS]
# SUNWAI_SERVER__CORS_ORIGINS=
# Enable bounded job admission. [DUB_ADMISSION]
# SUNWAI_SERVER__ADMISSION=
# Chunks dispatched per language in parallel. [DUB_FANOUT]
# SUNWAI_SERVER__FANOUT=
# Longest accepted source window, seconds. [DUB_MAX_DUR_S]
# SUNWAI_SERVER__MAX_DUR_S=
# Longest accepted edited line, characters. [DUB_MAX_EDIT_CHARS]
# SUNWAI_SERVER__MAX_EDIT_CHARS=
# Maximum queued jobs. [DUB_MAX_QUEUED_JOBS]
# SUNWAI_SERVER__MAX_QUEUED_JOBS=
# Latest accepted window start, seconds. [DUB_MAX_START_S]
# SUNWAI_SERVER__MAX_START_S=
# Maximum target languages per job. [DUB_MAX_TARGETS]
# SUNWAI_SERVER__MAX_TARGETS=
# Maximum concurrent jobs not yet cached. [DUB_MAX_UNCACHED_JOBS]
# SUNWAI_SERVER__MAX_UNCACHED_JOBS=
# Longest accepted source video, seconds. [DUB_MAX_VIDEO_S]
# SUNWAI_SERVER__MAX_VIDEO_S=
# Maximum work seconds admitted per job. [DUB_MAX_WORK_S]
# SUNWAI_SERVER__MAX_WORK_S=
# Reconcile language-track state on startup. [DUB_RECONCILE]
# SUNWAI_SERVER__RECONCILE=
# Path to a services JSON used by the supervisor. [DUB_SERVICES]
# SUNWAI_SERVER__SERVICES=

# ---- Optional local IndicTrans2 and separation mirrors ---------------------
# IndicTrans2 mirror: maximum request body, bytes. [IT2_MAX_BODY]
# SUNWAI_MIRRORS__IT2_MAX_BODY=
# IndicTrans2 mirror: maximum characters per request. [IT2_MAX_CHARS]
# SUNWAI_MIRRORS__IT2_MAX_CHARS=
# IndicTrans2 mirror: maximum queued requests. [IT2_MAX_PENDING]
# SUNWAI_MIRRORS__IT2_MAX_PENDING=
# IndicTrans2 mirror: maximum generated tokens. [IT2_MAX_TOKENS]
# SUNWAI_MIRRORS__IT2_MAX_TOKENS=
# IndicTrans2 mirror: directory with the model checkpoints. [IT2_MODELS_DIR]
# SUNWAI_MIRRORS__IT2_MODELS_DIR=
# Separator: only paths under this directory are accepted. [SEP_ROOT]
# SUNWAI_MIRRORS__SEP_ROOT=
# Separator: GPU selection. [SEP_GPU]
# SUNWAI_MIRRORS__SEP_GPU=
# Separator: concurrent audio decodes. [SEP_DECODE_PARALLEL]
# SUNWAI_MIRRORS__SEP_DECODE_PARALLEL=
